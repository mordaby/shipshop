{
  "name": "@chatprint/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Core API: business logic, prices, permissions, order state, webhooks, storage",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed-cli.ts",
    "storage:init": "tsx --env-file-if-exists=../../.env src/storage/init-dev-bucket-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-presigned-post": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@chatprint/providers": "workspace:*",
    "@chatprint/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
