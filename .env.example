# Copy to .env and fill in. Never commit .env.

# App
NODE_ENV=development
PUBLIC_BASE_URL=
CORE_API_URL=
MCP_PUBLIC_URL=

# Database
DATABASE_URL=

# File storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Auth (OAuth 2.1 authorization server)
OAUTH_ISSUER=
JWT_SIGNING_KEY=

# Gelato (use draft orders in development)
GELATO_API_KEY=
GELATO_WEBHOOK_SECRET=

# Israeli payment processor (vendor not chosen yet)
# fake (dev only) until the processor is chosen
PAYMENT_PROCESSOR=fake
PAYMENT_PROCESSOR_API_KEY=
PAYMENT_PROCESSOR_WEBHOOK_SECRET=
PAYMENT_PROCESSOR_SANDBOX=true

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# AI models (vendors not chosen yet)
IMAGE_MODEL_API_KEY=
UPSCALER_API_KEY=
VISION_MODEL_API_KEY=

# SMS and email (vendor not chosen yet; console = dev only, prints messages)
SMS_PROVIDER=console
EMAIL_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Invoicing (vendor not chosen yet)
INVOICING_API_KEY=
