# Copy to .env and fill in. Never commit .env.

# App
NODE_ENV=development
PUBLIC_BASE_URL=
CORE_API_URL=
MCP_PUBLIC_URL=

# Local services (read only by docker-compose, never by the apps)
# Password for the local Postgres container; put the same one in DATABASE_URL.
LOCAL_POSTGRES_PASSWORD=

# Database
# Local: postgres://chatprint:<LOCAL_POSTGRES_PASSWORD>@127.0.0.1:5432/chatprint
DATABASE_URL=

# File storage (S3-compatible). Local RustFS from docker-compose:
# endpoint http://127.0.0.1:9000, region us-east-1, path-style true; the
# access key pair you set here also becomes the RustFS root login.
# Empty endpoint means AWS S3, derived from the region.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true for stores that need path-style URLs (RustFS, MinIO); false for AWS S3.
STORAGE_FORCE_PATH_STYLE=

# Auth (OAuth 2.1 authorization server)
OAUTH_ISSUER=
JWT_SIGNING_KEY=

# Gelato (use draft orders in development)
GELATO_API_KEY=
GELATO_WEBHOOK_SECRET=

# Israeli payment processor (vendor not chosen yet)
# fake (dev only) until the processor is chosen
PAYMENT_PROCESSOR=fake
PAYMENT_PROCESSOR_API_KEY=
PAYMENT_PROCESSOR_WEBHOOK_SECRET=
PAYMENT_PROCESSOR_SANDBOX=true

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# AI models (vendors not chosen yet)
IMAGE_MODEL_API_KEY=
UPSCALER_API_KEY=
VISION_MODEL_API_KEY=

# SMS and email (vendor not chosen yet; console = dev only, prints messages)
SMS_PROVIDER=console
EMAIL_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Invoicing (vendor not chosen yet)
INVOICING_API_KEY=
